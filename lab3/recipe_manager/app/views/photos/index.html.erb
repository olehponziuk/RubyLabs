<% content_for :title, "Всі фото" %>

<div class="d-flex align-items-center justify-content-between mb-4">
  <h1 class="h2 mb-0">Фото</h1>
  <%= link_to "+ Додати фото", new_photo_path, class: "btn btn-success" %>
</div>

<% if @photos.empty? %>
  <div class="text-center py-5 text-muted">
    <p class="fs-5">Фото ще немає.</p>
  </div>
<% else %>
  <div class="row row-cols-1 row-cols-md-3 g-4">
    <% @photos.each do |photo| %>
      <div class="col">
        <div class="card h-100 shadow-sm border-0">
          <img src="<%= photo.url %>" class="card-img-top" style="height:180px;object-fit:cover" alt="<%= photo.caption %>">
          <div class="card-body">
            <p class="card-text text-muted small mb-0"><%= photo.caption.presence || "Без підпису" %></p>
          </div>
          <div class="card-footer bg-transparent d-flex gap-2">
            <%= link_to "Переглянути", photo, class: "btn btn-sm btn-outline-success" %>
            <%= link_to "✏", edit_photo_path(photo), class: "btn btn-sm btn-outline-secondary" %>
            <%= button_to "🗑", photo, method: :delete,
                  form: { class: "d-inline" },
                  class: "btn btn-sm btn-outline-danger",
                  data: { turbo_confirm: "Видалити?" } %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
