<% content_for :title, "Редагувати фото" %>

<div class="row justify-content-center">
  <div class="col-lg-5">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-warning text-dark">
        <h2 class="h5 mb-0">✏ Редагувати фото</h2>
      </div>
      <div class="card-body p-4">
        <%= render "form", photo: @photo %>
      </div>
    </div>
    <div class="mt-3">
      <%= link_to "← Назад", @photo, class: "text-muted text-decoration-none" %>
    </div>
  </div>
</div>
