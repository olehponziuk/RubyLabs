<% content_for :title, "Фото" %>

<div class="row justify-content-center">
  <div class="col-lg-6">
    <div class="card shadow-sm border-0">
      <div class="card-body text-center p-4">
        <img src="<%= @photo.url %>" class="img-fluid rounded mb-3" alt="<%= @photo.caption %>">
        <% if @photo.caption.present? %>
          <p class="text-muted"><%= @photo.caption %></p>
        <% end %>
      </div>
      <div class="card-footer bg-transparent d-flex gap-2">
        <%= link_to "✏ Редагувати", edit_photo_path(@photo), class: "btn btn-outline-secondary" %>
        <%= button_to "🗑 Видалити", @photo,
              method: :delete,
              form: { class: "d-inline" },
              class: "btn btn-outline-danger",
              data: { turbo_confirm: "Видалити фото?" } %>
        <% if @photo.recipe_id %>
          <%= link_to "← До рецепту", recipe_path(@photo.recipe_id), class: "btn btn-light ms-auto" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
