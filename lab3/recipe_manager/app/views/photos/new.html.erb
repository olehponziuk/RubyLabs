<% content_for :title, "Нове фото" %>

<div class="row justify-content-center">
  <div class="col-lg-5">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-success text-white">
        <h2 class="h5 mb-0">Додати фото</h2>
      </div>
      <div class="card-body p-4">
        <%= render "form", photo: @photo %>
      </div>
    </div>
    <div class="mt-3">
      <%= link_to "← Назад", @photo.recipe_id ? recipe_path(@photo.recipe_id) : photos_path, class: "text-muted text-decoration-none" %>
    </div>
  </div>
</div>
