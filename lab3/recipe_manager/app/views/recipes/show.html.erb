<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
        <h2 class="h4 mb-0"><%= @recipe.title %></h2>
        <% if @recipe.published %>
          <span class="badge bg-light text-success">Опубліковано</span>
        <% end %>
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-sm-6">
            <div class="p-3 bg-light rounded">
              <div class="text-muted small mb-1">Категорія</div>
              <strong><%= @recipe.category.presence || "—" %></strong>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="p-3 bg-light rounded">
              <div class="text-muted small mb-1">Складність</div>
              <%= difficulty_badge(@recipe) %>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="p-3 bg-light rounded">
              <div class="text-muted small mb-1">Час приготування</div>
              <strong>⏱ <%= @recipe.cooking_time %> хв</strong>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="p-3 bg-light rounded">
              <div class="text-muted small mb-1">Порції</div>
              <strong>🍽 <%= @recipe.servings %></strong>
            </div>
          </div>
        </div>
      </div>
      <% if @recipe.steps.present? %>
        <div class="card-body border-top">
          <h5 class="mb-3">Кроки приготування</h5>
          <div class="text-muted" style="white-space: pre-line"><%= @recipe.steps %></div>
        </div>
      <% end %>

      <% if @photos.any? %>
        <div class="card-body border-top">
          <h5 class="mb-3">Фото</h5>
          <div class="row g-2">
            <% @photos.each do |photo| %>
              <div class="col-sm-4">
                <img src="<%= photo.url %>" class="img-fluid rounded" alt="<%= photo.caption %>">
                <% if photo.caption.present? %>
                  <p class="small text-muted mt-1 mb-0"><%= photo.caption %></p>
                <% end %>
                <div class="mt-1">
                  <%= link_to "✏", edit_photo_path(photo), class: "btn btn-sm btn-outline-secondary me-1" %>
                  <%= button_to "🗑", photo, method: :delete,
                        form: { class: "d-inline" },
                        class: "btn btn-sm btn-outline-danger",
                        data: { turbo_confirm: "Видалити фото?" } %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="card-body border-top pt-2 pb-2">
        <%= link_to "+ Додати фото", new_photo_path(recipe_id: @recipe.id), class: "btn btn-sm btn-outline-secondary" %>
      </div>

      <div class="card-footer bg-transparent d-flex gap-2">
        <%= link_to "✏ Редагувати", edit_recipe_path(@recipe), class: "btn btn-outline-success" %>
        <%= button_to "🗑 Видалити", @recipe,
              method: :delete,
              form: { class: "d-inline" },
              class: "btn btn-outline-danger",
              data: { turbo_confirm: "Видалити «#{@recipe.title}»?" } %>
        <%= link_to "← Назад",     recipes_path, class: "btn btn-light ms-auto" %>
      </div>
    </div>
  </div>
</div>
