<div class="d-flex align-items-center justify-content-between mb-4">
  <h1 class="h2 mb-0">Рецепти</h1>
  <div class="d-flex gap-2">
    <%= link_to "⭐ Опубліковані", published_recipes_path, class: "btn btn-outline-warning" %>
    <%= link_to "+ Новий рецепт",  new_recipe_path,        class: "btn btn-success" %>
  </div>
</div>

<% if @recipes.empty? %>
  <div class="text-center py-5 text-muted">
    <p class="fs-5">Рецептів ще немає.</p>
    <%= link_to "Додати перший рецепт", new_recipe_path, class: "btn btn-success mt-2" %>
  </div>
<% else %>
  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <% @recipes.each do |recipe| %>
      <div class="col">
        <div class="card h-100 shadow-sm border-0">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h5 class="card-title mb-0"><%= recipe.title %></h5>
              <% if recipe.published %>
                <span class="badge bg-success ms-2">Опублік.</span>
              <% end %>
            </div>

            <div class="mb-2">
              <% if recipe.category.present? %>
                <span class="badge bg-primary"><%= recipe.category %></span>
              <% end %>
              <span class="badge badge-<%= recipe.difficulty %>"><%= recipe.difficulty %></span>
            </div>

            <p class="card-text text-muted small mb-0">
              ⏱ <%= recipe.cooking_time %> хв &nbsp;·&nbsp; 🍽 <%= recipe.servings %> порцій
            </p>
          </div>

          <div class="card-footer bg-transparent border-top-0 d-flex gap-3 align-items-center">
            <%= link_to "Переглянути", recipe,                class: "btn btn-sm btn-outline-success" %>
            <%= link_to "Редагувати",  edit_recipe_path(recipe), class: "btn btn-sm btn-outline-secondary" %>
            <%= button_to "Видалити", recipe,
                  method: :delete,
                  form: { class: "d-inline" },
                  class: "btn-delete",
                  data: { turbo_confirm: "Видалити рецепт «#{recipe.title}»?" } %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
