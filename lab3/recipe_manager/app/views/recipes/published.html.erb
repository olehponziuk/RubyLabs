<div class="d-flex align-items-center justify-content-between mb-4">
  <div>
    <h1 class="h2 mb-0">⭐ Опубліковані рецепти</h1>
    <p class="text-muted mb-0 small">Рецепти відмічені як опубліковані</p>
  </div>
  <%= link_to "← Всі рецепти", recipes_path, class: "btn btn-outline-secondary" %>
</div>

<% if @recipes.empty? %>
  <div class="text-center py-5 text-muted">
    <p class="fs-5">Немає опублікованих рецептів.</p>
  </div>
<% else %>
  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <% @recipes.each do |recipe| %>
      <div class="col">
        <div class="card h-100 shadow-sm border-0 border-start border-4 border-success">
          <div class="card-body">
            <h5 class="card-title"><%= link_to recipe.title, recipe, class: "text-decoration-none text-dark" %></h5>
            <div class="mb-2">
              <% if recipe.category.present? %>
                <span class="badge bg-primary"><%= recipe.category %></span>
              <% end %>
              <span class="badge badge-<%= recipe.difficulty %>"><%= recipe.difficulty %></span>
            </div>
            <p class="text-muted small mb-0">⏱ <%= recipe.cooking_time %> хв</p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
