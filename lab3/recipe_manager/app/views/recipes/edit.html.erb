<div class="row justify-content-center">
  <div class="col-lg-7">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-warning text-dark">
        <h2 class="h5 mb-0">✏ Редагувати: <%= @recipe.title %></h2>
      </div>
      <div class="card-body p-4">
        <%= render "form", recipe: @recipe %>
      </div>
    </div>
    <div class="mt-3">
      <%= link_to "← Назад до рецепту", recipe_path(@recipe), class: "text-muted text-decoration-none" %>
    </div>
  </div>
</div>
