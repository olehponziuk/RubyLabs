<% content_for :title, "Категорії" %>

<div class="d-flex align-items-center justify-content-between mb-4">
  <h1 class="h2 mb-0">Категорії</h1>
  <%= link_to "+ Нова категорія", new_category_path, class: "btn btn-success" %>
</div>

<% if @categories.empty? %>
  <div class="text-center py-5 text-muted">
    <p class="fs-5">Категорій ще немає.</p>
    <%= link_to "Додати категорію", new_category_path, class: "btn btn-success mt-2" %>
  </div>
<% else %>
  <div class="card shadow-sm border-0">
    <table class="table table-hover mb-0">
      <thead class="table-success">
        <tr>
          <th>Назва</th>
          <th class="text-end">Дії</th>
        </tr>
      </thead>
      <tbody>
        <% @categories.each do |category| %>
          <tr>
            <td class="align-middle fw-medium"><%= category.name %></td>
            <td class="text-end align-middle">
              <%= link_to "Переглянути", category,                  class: "btn btn-sm btn-outline-success" %>
              <%= link_to "Редагувати",  edit_category_path(category), class: "btn btn-sm btn-outline-secondary" %>
              <%= button_to "Видалити", category,
                    method: :delete,
                    form: { class: "d-inline" },
                    class: "btn btn-sm btn-outline-danger",
                    data: { turbo_confirm: "Видалити категорію «#{category.name}»?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
