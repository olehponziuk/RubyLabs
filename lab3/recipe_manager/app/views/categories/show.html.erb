<% content_for :title, @category.name %>

<div class="row justify-content-center">
  <div class="col-lg-6">
    <div class="card shadow-sm border-0">
      <div class="card-header bg-success text-white">
        <h2 class="h5 mb-0">Категорія</h2>
      </div>
      <div class="card-body p-4">
        <p class="fs-4 fw-semibold mb-0"><%= @category.name %></p>
      </div>
      <div class="card-footer bg-transparent d-flex gap-2">
        <%= link_to "✏ Редагувати", edit_category_path(@category), class: "btn btn-outline-success" %>
        <%= button_to "🗑 Видалити", @category,
              method: :delete,
              form: { class: "d-inline" },
              class: "btn btn-outline-danger",
              data: { turbo_confirm: "Видалити «#{@category.name}»?" } %>
        <%= link_to "← Назад", categories_path, class: "btn btn-light ms-auto" %>
      </div>
    </div>
  </div>
</div>
